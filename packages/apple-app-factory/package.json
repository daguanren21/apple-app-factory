{
  "name": "apphx",
  "version": "2.1.0",
  "description": "Host-native harness for verified Flutter, Java Android, Swift, React Native, Expo, uni-app and MyGo macOS delivery",
  "license": "MIT",
  "type": "module",
  "preferUnplugged": true,
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "apphx": "./dist/cli.js",
    "obfuscator": "./dist/vendor/obfuscator/dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "evals",
    "scripts",
    "benchmarks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/apple-app-factory.git",
    "directory": "packages/apple-app-factory"
  },
  "scripts": {
    "build": "tsdown && node scripts/bundle-obfuscator.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepack": "pnpm --workspace-root exec turbo run build typecheck --filter=apphx"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "obfuscator": "workspace:*"
  }
}
