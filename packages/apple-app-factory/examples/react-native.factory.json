{
  "stateDir": ".factory",
  "workspaceRoot": "workspaces",
  "allowLocalExecution": false,
  "allowCloudBuild": false,
  "packageTarget": "aab",
  "obfuscation": {
    "options": {
      "code": {
        "removeComments": true
      }
    }
  },
  "executionEnv": [
    "ANDROID_HOME",
    "ANDROID_DEVICE_ID"
  ],
  "verification": {
    "prerequisites": [
      [
        "node",
        "--version"
      ],
      [
        "java",
        "-version"
      ],
      [
        "adb",
        "version"
      ]
    ],
    "checks": [
      [
        "npm",
        "run",
        "lint"
      ],
      [
        "npm",
        "test",
        "--",
        "--runInBand"
      ]
    ],
    "runtime": [
      [
        "npm",
        "run",
        "test:e2e",
        "--",
        "--platform",
        "android",
        "--device",
        "${ANDROID_DEVICE_ID}"
      ]
    ]
  },
  "packaging": {
    "provider": "local",
    "commands": [
      [
        "./android/gradlew",
        "-p",
        "android",
        ":app:bundleRelease"
      ]
    ],
    "artifactPath": "android/app/build/outputs/bundle/release/app-release.aab"
  }
}
