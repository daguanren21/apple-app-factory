{
  "stateDir": ".factory",
  "workspaceRoot": "workspaces",
  "allowLocalExecution": false,
  "allowSubmit": false,
  "allowRelease": false,
  "allowCloudBuild": false,
  "packageTarget": "aab",
  "executionEnv": ["ANDROID_HOME", "ANDROID_DEVICE_ID"],
  "verification": {
    "prerequisites": [["node", "--version"], ["eas", "--version"], ["java", "-version"], ["adb", "version"]],
    "checks": [["npm", "run", "lint"], ["npm", "test", "--", "--runInBand"]],
    "runtime": [["npm", "run", "test:e2e", "--", "--platform", "android", "--device", "${ANDROID_DEVICE_ID}"]]
  },
  "packaging": {
    "provider": "local",
    "commands": [["eas", "build", "--platform", "android", "--profile", "production", "--local", "--non-interactive", "--output", "build/app.aab"]],
    "artifactPath": "build/app.aab"
  }
}
