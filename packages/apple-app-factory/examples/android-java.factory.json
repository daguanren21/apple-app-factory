{
  "stateDir": ".factory",
  "workspaceRoot": "workspaces",
  "allowLocalExecution": false,
  "allowCloudBuild": false,
  "packageTarget": "aab",
  "executionEnv": ["ANDROID_HOME", "ANDROID_SERIAL"],
  "verification": {
    "prerequisites": [["java", "-version"], ["adb", "version"]],
    "checks": [["./gradlew", ":app:lintDebug", ":app:testDebugUnitTest"]],
    "runtime": [["./gradlew", ":app:connectedDebugAndroidTest"]]
  },
  "packaging": {
    "provider": "local",
    "commands": [["./gradlew", ":app:bundleRelease"]],
    "artifactPath": "app/build/outputs/bundle/release/app-release.aab"
  }
}
