{
  "projectMode": "project",
  "projectRoot": ".",
  "allowLocalExecution": false,
  "allowCloudBuild": false,
  "packageTarget": "simulator",
  "obfuscation": {
    "options": {
      "code": {
        "removeComments": true
      }
    }
  },
  "executionEnv": [
    "IOS_DEVICE_ID"
  ],
  "verification": {
    "prerequisites": [
      [
        "xcodebuild",
        "-version"
      ]
    ],
    "checks": [
      [
        "flutter",
        "analyze",
        "--fatal-infos"
      ],
      [
        "flutter",
        "test"
      ]
    ],
    "runtime": [
      [
        "flutter",
        "drive",
        "--driver",
        "test_driver/integration_test.dart",
        "--target",
        "integration_test/app_test.dart",
        "-d",
        "${IOS_DEVICE_ID}",
        "--no-pub"
      ]
    ]
  },
  "workflow": {},
  "maxHostTurns": 64,
  "uiQuality": true
}
